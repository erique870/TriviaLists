# Sem DATABASE_URL, os dados ficam em memória e são perdidos ao reiniciar.
# Para PostgreSQL/Supabase, informe a URI de conexão do banco (não a API REST).
DATABASE_URL=
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
JWT_SECRET_KEY=altere-para-um-segredo-aleatorio-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_TIMEZONE=America/Sao_Paulo
DB_POOL_SIZE=5
WORKER_INTERVAL_SECONDS=30

# Demonstração local sem banco: cria parceiros e cliente com senha demo12345.
# É ignorado quando DATABASE_URL está preenchida.
APP_DEMO=false

# Opcional: serviço externo que recebe eventos e envia push aos seus inscritos.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Banco de testes: os testes criam e removem somente schemas próprios teste_<uuid>.
TEST_DATABASE_URL=
